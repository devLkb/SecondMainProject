# PetChain Docker Compose environment
# Copy to .env at the repository root and replace secrets before deployment.

# ── Public entrypoint ──────────────────────────
# Nginx frontend host port. Use 80 for http://localhost or another public HTTP port.
APP_PORT=80
# Public frontend origin used after OAuth success redirects.
FRONTEND_URL=http://localhost
# Backend CORS origins. Same-origin Nginx access usually only needs the public frontend origin.
CORS_ALLOWED_ORIGINS=http://localhost

# ── MySQL ──────────────────────────────────────
DB_NAME=petchain
DB_USERNAME=root
DB_PASSWORD=change-me-strong-db-password

# ── Spring Boot / admin ────────────────────────
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=change-me-strong-admin-password

# ── JWT ────────────────────────────────────────
# Use a long random value. HS256 requires at least 256 bits (32+ bytes) of entropy.
JWT_SECRET=change-me-to-a-long-random-jwt-secret-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRATION=1800000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ── OAuth: Google ──────────────────────────────
# Register the same redirect URI in the provider console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/api/auth/oauth/google/callback

# ── OAuth: Naver ───────────────────────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost/api/auth/oauth/naver/callback

# ── OAuth: Kakao ───────────────────────────────
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost/api/auth/oauth/kakao/callback
