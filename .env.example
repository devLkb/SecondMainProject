DB_HOST=localhost
DB_PORT=3306
DB_NAME=petchain
DB_USERNAME=root
DB_PASSWORD=your_password_here

# ── JWT ────────────────────────────────────────
# 최소 256bit(32자 이상) 랜덤 문자열 권장
JWT_SECRET=your-jwt-secret-key-must-be-at-least-32-characters-long
# 1시간 (ms)
JWT_ACCESS_TOKEN_EXPIRATION=3600000
# 7일 (ms)
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ── Spring Boot ────────────────────────────────
SERVER_PORT=8080
