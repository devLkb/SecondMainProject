DB_HOST=localhost
DB_PORT=3306
DB_NAME=petchain
DB_USERNAME=root
DB_PASSWORD=1234

# ── JWT ────────────────────────────────────────
# 최소 256bit(32자 이상) 랜덤 문자열 권장
JWT_SECRET=your-jwt-secret-key-must-be-at-least-32-characters-long
JWT_ACCESS_TOKEN_EXPIRATION=3600000    # 1시간 (ms)
JWT_REFRESH_TOKEN_EXPIRATION=604800000 # 7일 (ms)

# ── Spring Boot ────────────────────────────────
SERVER_PORT=8080

# ── 프론트엔드 ──────────────────────────────────
# OAuth 콜백 성공 후 토큰을 붙여 리다이렉트할 주소
FRONTEND_URL=http://localhost:5173

# ── OAuth: Google ──────────────────────────────
# https://console.cloud.google.com → API 및 서비스 → 사용자 인증 정보
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/oauth/google/callback

# ── OAuth: Naver ───────────────────────────────
# https://developers.naver.com/apps → 애플리케이션 등록
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:8080/api/auth/oauth/naver/callback

# ── OAuth: Kakao ───────────────────────────────
# https://developers.kakao.com → 내 애플리케이션 → REST API 키
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/api/auth/oauth/kakao/callback